# Conta e sincronização (opcional — o app funciona 100% local sem isso).
#
# Para ativar:
# 1. Crie um projeto gratuito em https://supabase.com
# 2. No painel: SQL Editor → cole e rode o conteúdo de supabase/schema.sql
# 3. No painel: Settings → API → copie "Project URL" e "anon public" key
# 4. Copie este arquivo para .env e preencha os valores abaixo
# 5. Reinicie o `npx expo start` (variáveis são lidas no início do bundle)

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
